{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.knowhere.invalid/knowhere.themepack-0.1.schema.json",
  "title": "knowhere.themepack 0.1",
  "description": "A distributable bundle of knowhere.theme documents plus optional built-in wallpaper metadata (Prism). Each entry of themes[] is a complete knowhere.theme document and is versioned on its own (R-17 applies per theme).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "id", "name", "version", "themes"],
  "properties": {
    "schema": { "const": "knowhere.themepack" },
    "schemaVersion": { "type": "string", "pattern": "^0\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,39}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 40 },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})$" },
    "themes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "knowhere.theme-0.1.schema.json" }
    },
    "wallpapers": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "name", "mediaType", "width", "height", "sha256"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 40 },
          "mediaType": { "enum": ["image/webp", "image/png", "image/jpeg", "image/avif"] },
          "width": { "type": "integer", "minimum": 1, "maximum": 16384 },
          "height": { "type": "integer", "minimum": 1, "maximum": 16384 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "dominantColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
        }
      }
    }
  }
}
