{
  "schema": "knowhere.themepack",
  "schemaVersion": "0.1.0",
  "id": "knowhere-core",
  "name": "Knowhere Core",
  "version": "1.0.0",
  "themes": [
    {
      "schema": "knowhere.theme",
      "schemaVersion": "0.1.0",
      "name": "Knowhere Default",
      "seedColor": "#6750A4",
      "colorScheme": "dark",
      "cornerRadius": 12,
      "font": "inter",
      "density": "comfortable",
      "wallpaper": null,
      "extensions": {}
    },
    {
      "schema": "knowhere.theme",
      "schemaVersion": "0.1.0",
      "name": "Knowhere Light",
      "seedColor": "#00658F",
      "colorScheme": "light",
      "cornerRadius": 12,
      "font": "roboto-flex",
      "density": "comfortable",
      "wallpaper": {
        "ref": "builtin:aurora"
      },
      "extensions": {}
    }
  ],
  "wallpapers": [
    {
      "key": "aurora",
      "name": "Aurora",
      "mediaType": "image/webp",
      "width": 3840,
      "height": 2160,
      "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "dominantColor": "#203040"
    }
  ]
}
